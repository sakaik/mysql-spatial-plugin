# MySQL binary / source — all ignored; see plugins/spatial_plugin/extract-buildkit.sh
# and README for how they are set up. Legacy dev dirs (mysql970/, mysql960/) are
# kept locally for now but not committed.
# - mysql-buildkits/: extracted headers + libmysqlservices.a per MySQL version + shared boost
# - build-artifacts/: per-version .so outputs from docker-build.sh
# - mysql-<VER>/ and mysql-<VER>.source/: native dev installs (e.g. 26.7.0)
mysql-buildkits/
build-artifacts/
mysql-*.*.*/
mysql-*.*.*.source/
mysql970/
mysql970.source/
mysql960/
mysql960.source/
mysql-*.tar.xz
mysql-*.tar.gz

# Dev-only files (kept in local claude/ repo)
CLAUDE.md
claude/
plugins/my_calc_plugin/
local.mk

# Build artifacts
*.o
# `make` output for the native dev build (the released spatial_plugin-glibc-*.so binaries ARE tracked)
/plugins/spatial_plugin/spatial_plugin.so

# Claude Code config
.claude/

# Editor / IDE
.vscode/
*.swp
*~

# Gemini artifacts
*.gemini
