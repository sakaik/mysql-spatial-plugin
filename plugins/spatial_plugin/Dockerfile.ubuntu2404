FROM ubuntu:24.04

# libssl-dev: MySQL 8.4's my_sys.h includes sql/stream_cipher.h -> <openssl/evp.h>
# (headers only; the plugin does not link libssl)
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y g++ cmake make libssl-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
